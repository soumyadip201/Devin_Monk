# WSL Environment Configuration for Data Ingestion Pipeline

# MongoDB Configuration
MONKDB_HOST=localhost
MONKDB_PORT=27017
MONKDB_DATABASE=monkdb
MONKDB_USERNAME=admin
MONKDB_PASSWORD=password

# API Keys (Get these from the respective services)
# OpenWeatherMap: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
STOCK_API_KEY=your_alphavantage_api_key_here

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=monkdb-data-ingestion

# Data Processing Configuration
CSV_DATA_DIRECTORY=./data
API_FETCH_INTERVAL=60
CSV_PROCESSING_INTERVAL=30

# Feature Toggles
ENABLE_KAFKA_STREAMING=true
ENABLE_API_FETCHING=true
ENABLE_CSV_PROCESSING=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/data_ingestion.log

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=1g

# Java Configuration (set by setup script)
JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
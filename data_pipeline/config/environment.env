# Data Pipeline Environment Configuration

# MongoDB Configuration
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/
MONGODB_DATABASE_NAME=data_pipeline

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# API Keys (Set these with your actual API keys)
WEATHER_API_KEY=your_openweathermap_api_key_here
STOCK_API_KEY=your_twelvedata_api_key_here

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=DataIngestionPipeline

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIRECTORY=data_pipeline/logs

# Data Directories
CSV_DATA_DIRECTORY=data
CHECKPOINT_BASE_DIRECTORY=/tmp/kafka-checkpoints

# Pipeline Configuration
PIPELINE_CONFIG=data_pipeline/config/pipeline_config.json

# Java Options for Spark (if needed)
JAVA_OPTS=-Xmx4g -Xms2g

# Python Path
PYTHONPATH=.